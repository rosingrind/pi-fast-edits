{
  "name": "pi-fast-edits",
  "version": "0.3.0",
  "description": "Fast anchored file editing tools for the Pi coding agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosingrind/pi-fast-edits.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "prettier": "^3.4.2"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "file-editing",
    "anchored-edits",
    "myers-diff"
  ],
  "engines": {
    "node": ">=20"
  }
}
